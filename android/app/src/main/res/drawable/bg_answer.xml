<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed fills, so a tap in a noisy carriage is visibly received even when
     the answer that follows takes a second to arrive. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/aqua_soft" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
