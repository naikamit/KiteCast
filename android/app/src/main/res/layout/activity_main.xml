<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fitsSystemWindows="true">

    <!-- ===== the app ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/menu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Exercises"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:id="@+id/lessonTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="14sp"
                    android:text="Choose an exercise" />
            </LinearLayout>

            <!-- the one thing you can catch without looking -->
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="32sp"
                android:text="Headphones on." />

            <TextView
                android:id="@+id/heard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/aqua"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/ink_faint"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/transport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:paddingStart="38dp"
                android:paddingEnd="38dp"
                android:backgroundTint="@color/aqua"
                android:textColor="@color/ground"
                android:textStyle="bold"
                android:text="Start" />

            <!-- what you can say: the primary affordance in a voice app -->
            <LinearLayout
                android:id="@+id/sayable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_sayable"
                android:padding="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Say one of these"
                    android:src="@drawable/ic_speak" />

                <TextView
                    android:id="@+id/vocab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tally"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:textColor="@color/ink_dim"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:text="not started" />

            <!-- commands are secondary: available, not advertised -->
            <TextView
                android:id="@+id/commands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/ink_faint"
                android:textSize="11sp"
                android:alpha="0.75"
                android:text="also: repeat · skip · score · pause" />

            <!-- Deliberate dead space. The log is for me, not for someone
                 being handed the phone to try; it stays below the fold. -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="220dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_faint"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:alpha="0.6"
                android:text="LOG — LONG-PRESS TO COPY" />

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@color/sunk"
                android:textColor="@color/ink_faint"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== exercises ===== -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/raise"
        android:fitsSystemWindows="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="26dp"
            android:paddingBottom="14dp"
            android:textColor="@color/ink_faint"
            android:textSize="10sp"
            android:letterSpacing="0.18"
            android:text="EXERCISES" />

        <ListView
            android:id="@+id/lessonList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/line_soft"
            android:dividerHeight="1dp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
