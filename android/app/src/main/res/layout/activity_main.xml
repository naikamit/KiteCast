<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/lessonNum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_faint"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:text="LESSON 1 OF 13" />

        <Spinner
            android:id="@+id/lessonPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:popupBackground="@color/raise" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:text="Headphones on." />

        <TextView
            android:id="@+id/heard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/brass"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/ink_faint"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/transport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="28dp"
            android:paddingStart="34dp"
            android:paddingEnd="34dp"
            android:backgroundTint="@color/brass"
            android:textColor="@color/ground"
            android:text="Start" />

        <TextView
            android:id="@+id/tally"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="@color/ink_dim"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:text="not started" />

        <TextView
            android:id="@+id/vocab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/ink_dim"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/ink_faint"
            android:textSize="11sp"
            android:letterSpacing="0.16"
            android:text="LOG" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="@color/raise"
            android:textColor="@color/ink_dim"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
