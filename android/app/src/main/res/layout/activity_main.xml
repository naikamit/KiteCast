<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="30dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/menu"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Exercises"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:id="@+id/lessonTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="15sp"
                    android:text="Choose an exercise" />
            </LinearLayout>

            <!-- 1. what to say, and what came back -->
            <LinearLayout
                android:id="@+id/sayable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:background="@drawable/bg_sayable"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Speak or tap the answer"
                        android:src="@drawable/ic_speak" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/aqua"
                        android:textSize="13sp"
                        android:letterSpacing="0.14"
                        android:text="SPEAK / TAP THE ANSWER" />
                </LinearLayout>

                <!-- Every answer is also a button. Speech is the point, but a
                     recogniser that will not hear you must not be the only
                     way through the question. -->
                <com.millsandgoon.ear.FlowLayout
                    android:id="@+id/vocab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <!-- the answer lands here, where you were already looking -->
                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:minHeight="42dp"
                    android:textColor="@color/ink"
                    android:textSize="30sp" />
            </LinearLayout>

            <!-- 2. the score, in the same two marks as the menu, with the
                 one button that empties it sitting on the same line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tallyRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginEnd="14dp"
                    android:textColor="@color/ok"
                    android:textSize="26sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tallyWrong"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:textColor="@color/bad"
                    android:textSize="26sp"
                    android:fontFamily="monospace" />

                <ImageButton
                    android:id="@+id/reset"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_reset"
                    android:scaleType="center"
                    android:contentDescription="Reset the score"
                    android:src="@drawable/ic_reset" />
            </LinearLayout>

            <!-- 3. where those notes live. Always here, always playable, and
                 marked up after a wrong answer. -->
            <com.millsandgoon.ear.Fretboard
                android:id="@+id/fretboard"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="24dp"
                android:contentDescription="Guitar neck — tap a fret to hear it" />

            <!-- 4. the only thing your thumb reaches for without looking -->
            <ImageButton
                android:id="@+id/transport"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_transport"
                android:scaleType="center"
                android:contentDescription="Start"
                android:src="@drawable/ic_play" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="220dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_faint"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:alpha="0.6"
                android:text="LOG — LONG-PRESS TO COPY" />

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@color/sunk"
                android:textColor="@color/ink_faint"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/raise"
        android:paddingTop="26dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="20dp"
            android:paddingBottom="14dp"
            android:textColor="@color/ink_faint"
            android:textSize="11sp"
            android:letterSpacing="0.18"
            android:text="EXERCISES" />

        <ExpandableListView
            android:id="@+id/lessonList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/line_soft"
            android:dividerHeight="1dp"
            android:childDivider="@color/line_soft"
            android:groupIndicator="@null" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
