<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground">

    <!-- ===== the app ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="30dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/menu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Exercises"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:id="@+id/lessonTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="14sp"
                    android:text="Choose an exercise" />
            </LinearLayout>

            <!-- the one thing you can catch without looking -->
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="32sp"
                android:text="Headphones on." />

            <TextView
                android:id="@+id/heard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/aqua"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/transport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="38dp"
                    android:paddingEnd="38dp"
                    android:backgroundTint="@color/aqua"
                    android:textColor="@color/ground"
                    android:textStyle="bold"
                    android:text="Start" />

                <!-- colourless on purpose: it undoes work, it should not invite -->
                <Button
                    android:id="@+id/reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="@drawable/bg_reset"
                    android:textColor="@color/ink_dim"
                    android:textSize="13sp"
                    android:text="Reset" />
            </LinearLayout>

            <!-- Everything you can do with your hands lives here. Your voice
                 only ever answers the question. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/again"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="13sp"
                    android:text="Play again" />

                <Button
                    android:id="@+id/skip"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="13sp"
                    android:text="Skip" />
            </LinearLayout>

            <!-- what you can say: the primary affordance in a voice app -->
            <LinearLayout
                android:id="@+id/sayable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="horizontal"
                android:gravity="top"
                android:background="@drawable/bg_sayable"
                android:padding="18dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="2dp"
                    android:contentDescription="Speak the answer"
                    android:src="@drawable/ic_speak" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/aqua"
                        android:textSize="11sp"
                        android:letterSpacing="0.14"
                        android:text="SPEAK THE ANSWER" />

                    <TextView
                        android:id="@+id/vocab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/ink"
                        android:textSize="17sp"
                        android:lineSpacingExtra="5dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tally"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:textColor="@color/ink_dim"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:text="not started" />

            <!-- commands are secondary: available, not advertised -->
            <!-- Deliberate dead space. The log is for me, not for someone
                 being handed the phone to try; it stays below the fold. -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="220dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_faint"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:alpha="0.6"
                android:text="LOG — LONG-PRESS TO COPY" />

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@color/sunk"
                android:textColor="@color/ink_faint"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== exercises ===== -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/raise"
        android:paddingTop="26dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="26dp"
            android:paddingBottom="14dp"
            android:textColor="@color/ink_faint"
            android:textSize="10sp"
            android:letterSpacing="0.18"
            android:text="EXERCISES" />

        <ExpandableListView
            android:id="@+id/lessonList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/line_soft"
            android:dividerHeight="1dp"
            android:childDivider="@color/line_soft"
            android:groupIndicator="@null" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
