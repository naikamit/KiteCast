# --- Kite Connect (my account; the ONE api_key used for both my orders and
# --- the friends' Publisher basket links) ---
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# Public base URL of this VPS (static IP / domain). Must match the redirect
# URL registered on the Kite Connect app: {BASE_URL}/kite/redirect
# The postback URL registered on the app must be: {BASE_URL}/kite/postback
BASE_URL=https://trades.example.com

# --- Telegram delivery (hard phone push; never email) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# --- State ---
DB_PATH=kitecast.db

# --- Open decision 10: share timing. "fill" (default) fans the mirror when
# --- MY order fills; "placement" fans it the moment I place the order.
SHARE_TIMING_ENTRY=fill
SHARE_TIMING_EXIT=fill

# Send autoslice=true on my close orders so Kite splits qty above the
# exchange freeze limit (at-any-cost exit).
KITE_AUTOSLICE=true

# MCX options reject bare MARKET orders; MARKET tickets on them become a
# protected LIMIT at LTP +/- these percents (Kite-app-style market
# protection). Entries tight (cap slippage), exits wide (at-any-cost).
MARKET_PROTECTION_PCT_ENTRY=5
MARKET_PROTECTION_PCT_EXIT=10

# Zerodha validates ORDER endpoints against ONE whitelisted static IP
# (developers.kite.trade -> Profile -> IP Whitelist; changeable once per
# calendar week). If this host doesn't have that IP (e.g. Render), route
# order calls through a static-IP proxy: http://user:pass@host:port
# Leave empty when the host's own IP is the whitelisted one (e.g. a VPS).
KITE_ORDER_PROXY=
